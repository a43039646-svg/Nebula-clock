{
  "theme": "auto",
  "display": {
    "show_seconds": true,
    "show_date": true,
    "show_title": true,
    "scale": "auto",
    "font": "digital",
    "block": "█",
    "fallback_block": "#"
  },
  "logo": {
    "enabled": false,
    "source": "auto",
    "position": "right",
    "custom": ""
  },
  "fetch": {
    "enabled": false,
