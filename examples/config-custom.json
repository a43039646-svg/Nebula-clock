    "position": "left"
  },
  "clock_box": {
    "enabled": false,
    "style": "rounded"
  },
  "custom_text": {
    "enabled": false,
    "text": "Have a nice day!",
    "position": "bottom"
  },
  "colors": {
    "clock": "#FFFFFF",
    "date": "#7fdfff",
    "title": "#00bfff",
    "box": "#5CC8FF",
